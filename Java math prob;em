import java.util.*;

public class Main {

    // 1. Reverse Number
    static int reverse(int n) {
        int rev = 0;
        while (n != 0) {
            rev = rev * 10 + n % 10;
            n /= 10;
        }
        return rev;
    }

    // 2. Palindrome Number
    static boolean isPalindrome(int n) {
        return n == reverse(n);
    }

    // 3. Factorial (Iterative)
    static long factorialIter(int n) {
        long fact = 1;
        for (int i = 1; i <= n; i++)
            fact *= i;
        return fact;
    }

    // 3. Factorial (Recursive)
    static long factorialRec(int n) {
        if (n == 0 || n == 1) return 1;
        return n * factorialRec(n - 1);
    }

    // 4. Fibonacci Series
    static void fibonacci(int n) {
        int a = 0, b = 1;
        System.out.print("Fibonacci: " + a + " " + b + " ");
        for (int i = 2; i < n; i++) {
            int c = a + b;
            System.out.print(c + " ");
            a = b;
            b = c;
        }
        System.out.println();
    }

    // 5. Prime Check
    static boolean isPrime(int n) {
        if (n <= 1) return false;
        for (int i = 2; i * i <= n; i++) {
            if (n % i == 0) return false;
        }
        return true;
    }

    // 6. Count Digits
    static int countDigits(int n) {
        int count = 0;
        while (n != 0) {
            count++;
            n /= 10;
        }
        return count;
    }

    // 7. Armstrong Number
    static boolean isArmstrong(int n) {
        int sum = 0, temp = n;
        int digits = countDigits(n);

        while (temp != 0) {
            int d = temp % 10;
            sum += Math.pow(d, digits);
            temp /= 10;
        }
        return sum == n;
    }

    // 8. GCD
    static int gcd(int a, int b) {
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }

    // 8. LCM
    static int lcm(int a, int b) {
        return (a * b) / gcd(a, b);
    }

    // 9. Sum of Digits
    static int sumDigits(int n) {
        int sum = 0;
        while (n != 0) {
            sum += n % 10;
            n /= 10;
        }
        return sum;
    }

    // 10. Swap Numbers
    static void swap(int a, int b) {
        System.out.println("Before Swap: a=" + a + ", b=" + b);

        // Without temp
        a = a + b;
        b = a - b;
        a = a - b;

        System.out.println("After Swap: a=" + a + ", b=" + b);
    }

    // MAIN METHOD
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter a number: ");
        int n = sc.nextInt();

        System.out.println("Reverse: " + reverse(n));

        System.out.println("Palindrome: " + isPalindrome(n));

        System.out.println("Factorial (Iterative): " + factorialIter(n));
        System.out.println("Factorial (Recursive): " + factorialRec(n));

        fibonacci(n);

        System.out.println("Prime: " + isPrime(n));

        System.out.println("Digit Count: " + countDigits(n));

        System.out.println("Armstrong: " + isArmstrong(n));

        System.out.print("Enter two numbers for GCD & LCM: ");
        int a = sc.nextInt();
        int b = sc.nextInt();

        System.out.println("GCD: " + gcd(a, b));
        System.out.println("LCM: " + lcm(a, b));

        System.out.println("Sum of Digits: " + sumDigits(n));

        swap(a, b);

        sc.close();
    }
}
