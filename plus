class Solution {
    public int[] plusOne(int[] digits) {
        int n = digits.length;

        // Traverse from the last digit
        for (int i = n - 1; i >= 0; i--) {
            // If digit is less than 9, increment and return
            if (digits[i] < 9) {
                digits[i]++;
                return digits;
            }

            // Set current digit to 0 if it was 9
            digits[i] = 0;
        }

        // If all digits were 9, create a new array
        int[] result = new int[n + 1];
        result[0] = 1;

        return result;
    }
}
