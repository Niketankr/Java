import java.util.*;

public class Main {

    // 1. Second Largest
    static int secondLargest(int[] arr) {
        int first = Integer.MIN_VALUE, second = Integer.MIN_VALUE;

        for (int x : arr) {
            if (x > first) {
                second = first;
                first = x;
            } else if (x > second && x != first) {
                second = x;
            }
        }
        return second;
    }

    // 2. Armstrong Number
    static boolean isArmstrong(int n) {
        int sum = 0, temp = n;
        while (temp != 0) {
            int d = temp % 10;
            sum += d * d * d;
            temp /= 10;
        }
        return sum == n;
    }

    // 3. Reverse Words
    static void reverseWords(String s) {
        String[] words = s.split(" ");
        for (int i = words.length - 1; i >= 0; i--) {
            System.out.print(words[i] + " ");
        }
        System.out.println();
    }

    // 4. Anagram
    static boolean isAnagram(String a, String b) {
        char[] x = a.toCharArray();
        char[] y = b.toCharArray();
        Arrays.sort(x);
        Arrays.sort(y);
        return Arrays.equals(x, y);
    }

    // 5. Move Zeros
    static void moveZeros(int[] arr) {
        int j = 0;
        for (int i = 0; i < arr.length; i++) {
            if (arr[i] != 0) {
                int temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
                j++;
            }
        }
    }

    // 6. Missing Number
    static int missingNumber(int[] arr, int n) {
        int sum = n * (n + 1) / 2;
        int arrSum = 0;
        for (int x : arr) arrSum += x;
        return sum - arrSum;
    }

    // 7. First Non-Repeating Character
    static char firstNonRepeat(String s) {
        int[] freq = new int[256];
        for (char c : s.toCharArray()) freq[c]++;
        for (char c : s.toCharArray()) {
            if (freq[c] == 1) return c;
        }
        return '#';
    }

    // 8. Prime Check
    static boolean isPrime(int n) {
        if (n <= 1) return false;
        for (int i = 2; i * i <= n; i++) {
            if (n % i == 0) return false;
        }
        return true;
    }

    // 9. Palindrome String
    static boolean isPalindrome(String s) {
        return s.equals(new StringBuilder(s).reverse().toString());
    }

    // 10. Count Vowels & Consonants
    static void countVC(String s) {
        int v = 0, c = 0;
        s = s.toLowerCase();

        for (char ch : s.toCharArray()) {
            if (Character.isLetter(ch)) {
                if ("aeiou".indexOf(ch) != -1) v++;
                else c++;
            }
        }

        System.out.println("Vowels: " + v + ", Consonants: " + c);
    }

    // Helper: Print Array
    static void printArray(int[] arr) {
        for (int x : arr) System.out.print(x + " ");
        System.out.println();
    }

    // MAIN METHOD
    public static void main(String[] args) {

        // 1. Second Largest
        int[] arr = {10, 20, 4, 45, 99};
        System.out.println("Second Largest: " + secondLargest(arr));

        // 2. Armstrong
        int num = 153;
        System.out.println("Armstrong: " + isArmstrong(num));

        // 3. Reverse Words
        System.out.print("Reverse Words: ");
        reverseWords("hello world java");

        // 4. Anagram
        System.out.println("Anagram: " + isAnagram("listen", "silent"));

        // 5. Move Zeros
        int[] zerosArr = {0, 1, 0, 3, 12};
        moveZeros(zerosArr);
        System.out.print("Move Zeros: ");
        printArray(zerosArr);

        // 6. Missing Number
        int[] missArr = {1, 2, 4, 5};
        System.out.println("Missing Number: " + missingNumber(missArr, 5));

        // 7. First Non-Repeating
        System.out.println("First Non-Repeating: " + firstNonRepeat("swiss"));

        // 8. Prime
        System.out.println("Prime (29): " + isPrime(29));

        // 9. Palindrome
        System.out.println("Palindrome (madam): " + isPalindrome("madam"));

        // 10. Vowels & Consonants
        countVC("hello");
    }
}
