class Solution {
    public int[] plusOne(int[] digits) {
        int n = digits.length;

        // Traverse from the last digit
        for (int i = n - 1; i >= 0; i--) {
            if (digits[i] < 9) {
                digits[i]++;  // Add 1 and return
                return digits;
            }
            digits[i] = 0;   // Carry over
        }

        // If all digits were 9, create a new array
        int[] result = new int[n + 1];
        result[0] = 1;
        return result;
    }
}
