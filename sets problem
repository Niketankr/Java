import java.util.*;

class Node {
    int data;
    Node left, right;

    Node(int data) {
        this.data = data;
    }
}

public class Main {

    // 1. Max Path Sum
    static int maxSum = Integer.MIN_VALUE;
    static int maxPath(Node root) {
        if (root == null) return 0;
        int l = Math.max(0, maxPath(root.left));
        int r = Math.max(0, maxPath(root.right));
        maxSum = Math.max(maxSum, l + r + root.data);
        return root.data + Math.max(l, r);
    }

    // 2. LCA
    static Node LCA(Node root, Node p, Node q) {
        if (root == null || root == p || root == q) return root;
        Node l = LCA(root.left, p, q);
        Node r = LCA(root.right, p, q);
        if (l == null) return r;
        if (r == null) return l;
        return root;
    }

    // 3. Diameter
    static int dia = 0;
    static int height(Node root) {
        if (root == null) return 0;
        int l = height(root.left);
        int r = height(root.right);
        dia = Math.max(dia, l + r);
        return 1 + Math.max(l, r);
    }

    // 4. Serialize
    static String serialize(Node root) {
        if (root == null) return "null,";
        return root.data + "," + serialize(root.left) + serialize(root.right);
    }

    // 5. Deserialize
    static Node deserialize(Queue<String> q) {
        String val = q.poll();
        if (val.equals("null")) return null;
        Node root = new Node(Integer.parseInt(val));
        root.left = deserialize(q);
        root.right = deserialize(q);
        return root;
    }

    // 6. Kth Smallest
    static int count = 0, kth = -1;
    static void kthSmallest(Node root, int k) {
        if (root == null) return;
        kthSmallest(root.left, k);
        count++;
        if (count == k) kth = root.data;
        kthSmallest(root.right, k);
    }

    // 7. Validate BST
    static boolean isValid(Node root, long min, long max) {
        if (root == null) return true;
        if (root.data <= min || root.data >= max) return false;
        return isValid(root.left, min, root.data) &&
               isValid(root.right, root.data, max);
    }

    // 8. Right View
    static int maxLevel = 0;
    static void rightView(Node root, int level) {
        if (root == null) return;
        if (level > maxLevel) {
            System.out.print(root.data + " ");
            maxLevel = level;
        }
        rightView(root.right, level + 1);
        rightView(root.left, level + 1);
    }

    // 9. Left View
    static void leftView(Node root, int level) {
        if (root == null) return;
        if (level > maxLevel) {
            System.out.print(root.data + " ");
            maxLevel = level;
        }
        leftView(root.left, level + 1);
        leftView(root.right, level + 1);
    }

    // 10. Level Order
    static void levelOrder(Node root) {
        Queue<Node> q = new LinkedList<>();
        q.add(root);
        while (!q.isEmpty()) {
            Node n = q.poll();
            System.out.print(n.data + " ");
            if (n.left != null) q.add(n.left);
            if (n.right != null) q.add(n.right);
        }
    }

    // 11. Zigzag
    static void zigzag(Node root) {
        Queue<Node> q = new LinkedList<>();
        q.add(root);
        boolean dir = true;

        while (!q.isEmpty()) {
            int size = q.size();
            List<Integer> list = new ArrayList<>();

            for (int i = 0; i < size; i++) {
                Node n = q.poll();
                if (dir) list.add(n.data);
                else list.add(0, n.data);

                if (n.left != null) q.add(n.left);
                if (n.right != null) q.add(n.right);
            }
            System.out.println(list);
            dir = !dir;
        }
    }

    // 12. Path Sum
    static boolean pathSum(Node root, int sum) {
        if (root == null) return false;
        if (root.left == null && root.right == null)
            return sum == root.data;
        return pathSum(root.left, sum - root.data) ||
               pathSum(root.right, sum - root.data);
    }

    // 13. Symmetric
    static boolean mirror(Node a, Node b) {
        if (a == null && b == null) return true;
        if (a == null || b == null) return false;
        return a.data == b.data &&
               mirror(a.left, b.right) &&
               mirror(a.right, b.left);
    }

    // 14. Sum Root to Leaf
    static int sumRoot(Node root, int sum) {
        if (root == null) return 0;
        sum = sum * 10 + root.data;
        if (root.left == null && root.right == null)
            return sum;
        return sumRoot(root.left, sum) + sumRoot(root.right, sum);
    }

    // 15. Flatten
    static void flatten(Node root) {
        if (root == null) return;
        flatten(root.left);
        flatten(root.right);

        Node temp = root.right;
        root.right = root.left;
        root.left = null;

        Node curr = root;
        while (curr.right != null) curr = curr.right;
        curr.right = temp;
    }

    // 16. Build Tree
    static int idx = 0;
    static Node build(int[] pre, int[] in, int l, int r) {
        if (l > r) return null;
        int val = pre[idx++];
        Node root = new Node(val);

        int pos = l;
        while (in[pos] != val) pos++;

        root.left = build(pre, in, l, pos - 1);
        root.right = build(pre, in, pos + 1, r);
        return root;
    }

    // 17. Balanced Tree
    static int check(Node root) {
        if (root == null) return 0;
        int l = check(root.left);
        int r = check(root.right);
        if (l == -1 || r == -1 || Math.abs(l - r) > 1)
            return -1;
        return 1 + Math.max(l, r);
    }

    // 18. Max Depth
    static int depth(Node root) {
        if (root == null) return 0;
        return 1 + Math.max(depth(root.left), depth(root.right));
    }

    // 19. Inorder
    static void inorder(Node root) {
        if (root == null) return;
        inorder(root.left);
        System.out.print(root.data + " ");
        inorder(root.right);
    }

    // 20. Preorder
    static void preorder(Node root) {
        if (root == null) return;
        System.out.print(root.data + " ");
        preorder(root.left);
        preorder(root.right);
    }

    // MAIN
    public static void main(String[] args) {

        Node root = new Node(1);
        root.left = new Node(2);
        root.right = new Node(3);

        System.out.println("Level Order:");
        levelOrder(root);

        System.out.println("\nMax Depth: " + depth(root));

        maxPath(root);
        System.out.println("Max Path Sum: " + maxSum);

        System.out.print("Right View: ");
        rightView(root, 1);
    }
}

