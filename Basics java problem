import java.util.*;
import java.io.*;

// Student Class
class Student {
    int id;
    String name;
}

// Employee Class
class Employee {
    int id;
    String name;
    double salary;
}

public class Main {

    // ================= ASSIGNMENT 7 =================

    // Sum of N Naturals
    static int sumN(int n) {
        if (n == 0) return 0;
        return n + sumN(n - 1);
    }

    // Power
    static int power(int a, int b) {
        if (b == 0) return 1;
        return a * power(a, b - 1);
    }

    // Factorial
    static int factorial(int n) {
        if (n <= 1) return 1;
        return n * factorial(n - 1);
    }

    // GCD
    static int gcd(int a, int b) {
        if (b == 0) return a;
        return gcd(b, a % b);
    }

    // LCM
    static int lcm(int a, int b) {
        return (a * b) / gcd(a, b);
    }

    // Fibonacci
    static int fib(int n) {
        if (n <= 1) return n;
        return fib(n - 1) + fib(n - 2);
    }

    // Armstrong Number
    static boolean armstrong(int n) {
        int sum = 0, temp = n;

        while (temp != 0) {
            int d = temp % 10;
            sum += d * d * d;
            temp /= 10;
        }

        return sum == n;
    }

    // Peterson Number
    static boolean peterson(int n) {
        int sum = 0, temp = n;

        while (temp != 0) {
            int d = temp % 10;
            sum += factorial(d);
            temp /= 10;
        }

        return sum == n;
    }

    // ================= ASSIGNMENT 8 =================

    // Linear Search
    static int linearSearch(int[] arr, int key) {
        for (int i = 0; i < arr.length; i++) {
            if (arr[i] == key)
                return i;
        }
        return -1;
    }

    // Binary Search
    static int binarySearch(int[] arr, int key) {
        int left = 0, right = arr.length - 1;

        while (left <= right) {
            int mid = (left + right) / 2;

            if (arr[mid] == key)
                return mid;
            else if (arr[mid] < key)
                left = mid + 1;
            else
                right = mid - 1;
        }

        return -1;
    }

    // Bubble Sort Descending
    static void bubbleSortDesc(int[] arr) {
        for (int i = 0; i < arr.length - 1; i++) {
            for (int j = 0; j < arr.length - i - 1; j++) {

                if (arr[j] < arr[j + 1]) {
                    int temp = arr[j];
                    arr[j] = arr[j + 1];
                    arr[j + 1] = temp;
                }
            }
        }
    }

    // Selection Sort Ascending
    static void selectionSortAsc(int[] arr) {
        for (int i = 0; i < arr.length; i++) {

            int min = i;

            for (int j = i + 1; j < arr.length; j++) {
                if (arr[j] < arr[min]) {
                    min = j;
                }
            }

            int temp = arr[i];
            arr[i] = arr[min];
            arr[min] = temp;
        }
    }

    // ================= ASSIGNMENT 10 =================

    // Swap Numbers
    static void swap(int[] arr) {
        int temp = arr[0];
        arr[0] = arr[1];
        arr[1] = temp;
    }

    // Reverse String
    static void reverseString(String str) {
        StringBuilder sb = new StringBuilder(str);
        System.out.println("Reversed String: " + sb.reverse());
    }

    // Print Array
    static void printArray(int[] arr) {
        for (int x : arr) {
            System.out.print(x + " ");
        }
        System.out.println();
    }

