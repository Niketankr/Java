import java.util.*;

public class Main {

    public static void main(
            String[] args
    ) {

        Scanner sc =
                new Scanner(System.in);

        HashMap<String,Integer>
                items =
                new HashMap<>();

        while (true) {

            System.out.println(
                    "\n1 Add"
            );

            System.out.println(
                    "2 View"
            );

            System.out.println(
                    "3 Exit"
            );

            int ch =
                    sc.nextInt();

            sc.nextLine();

            if (ch == 1) {

                System.out.print(
                        "Item: "
                );

                String item =
                        sc.nextLine();

                System.out.print(
                        "Quantity: "
                );

                int q =
                        sc.nextInt();

                items.put(
                        item,
                        q
                );
            }

            else if (ch == 2) {

                System.out.println(
                        items
                );
            }

            else {

                break;
            }
        }
    }
}
