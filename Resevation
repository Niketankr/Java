import java.util.*;

public class Main {

    public static void main(
            String[] args
    ) {

        Scanner sc =
                new Scanner(System.in);

        int seats = 40;

        while (true) {

            System.out.println(
                    "\nAvailable: "
                            + seats
            );

            System.out.println(
                    "1 Book"
            );

            System.out.println(
                    "2 Exit"
            );

            int ch =
                    sc.nextInt();

            if (ch == 1) {

                System.out.print(
                        "Seats: "
                );

                int book =
                        sc.nextInt();

                if (book <= seats) {

                    seats -= book;

                    System.out.println(
                            "Booked"
                    );
                }

                else {

                    System.out.println(
                            "Not Available"
                    );
                }
            }

            else {

                break;
            }
        }
    }
}
