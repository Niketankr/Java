import java.util.*;

public class Main {

    // Number of vertices
    private int vertices;

    // Adjacency List
    private LinkedList<Integer>[] adjList;

    // Constructor
    Main(int v) {

        vertices = v;

        adjList = new LinkedList[v];

        for (int i = 0; i < v; i++) {

            adjList[i] = new LinkedList<>();
        }
    }

    // Add Edge
    void addEdge(int v, int w) {

        adjList[v].add(w);
    }

    // ================= BFS =================
    void BFS(int start) {

        boolean[] visited = new boolean[vertices];

        Queue<Integer> queue = new LinkedList<>();

        visited[start] = true;

        queue.add(start);

        System.out.println("BFS Traversal:");

        while (!queue.isEmpty()) {

            int node = queue.poll();

            System.out.print(node + " ");

            for (int neighbor : adjList[node]) {

                if (!visited[neighbor]) {

                    visited[neighbor] = true;

                    queue.add(neighbor);
                }
            }
        }

        System.out.println();
    }

    // ================= DFS =================
    void DFS(int start) {

        boolean[] visited = new boolean[vertices];

        System.out.println("DFS Traversal:");

        DFSUtil(start, visited);

        System.out.println();
    }

    // DFS Helper Function
    void DFSUtil(int node, boolean[] visited) {

        visited[node] = true;

        System.out.print(node + " ");

        for (int neighbor : adjList[node]) {

            if (!visited[neighbor]) {

                DFSUtil(neighbor, visited);
            }
        }
    }

    // ================= MAIN METHOD =================
    public static void main(String[] args) {

        Main g = new Main(6);

        // Add edges
        g.addEdge(0, 1);
        g.addEdge(0, 2);
        g.addEdge(1, 3);
        g.addEdge(1, 4);
        g.addEdge(2, 5);

        // BFS
        g.BFS(0);

        // DFS
        g.DFS(0);
    }
}
