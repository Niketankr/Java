import java.util.*;

public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        double total = 0;

        while (true) {

            System.out.println("\n1 Add Expense");
            System.out.println("2 Show Total");
            System.out.println("3 Exit");

            int ch = sc.nextInt();

            if (ch == 1) {

                System.out.print("Enter expense: ₹");

                total += sc.nextDouble();
            }

            else if (ch == 2) {

                System.out.println(
                        "Total Expense = ₹"
                                + total
                );
            }

            else {

                break;
            }
        }

        sc.close();
    }
}
