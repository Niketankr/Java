import java.util.*;

public class Main {

    /* ===================== GRAPH (ADJ LIST) ===================== */
    static List<List<Integer>> graph;

    static void buildGraph(int n) {
        graph = new ArrayList<>();
        for (int i = 0; i < n; i++)
            graph.add(new ArrayList<>());
    }

    static void addEdge(int u, int v) {
        graph.get(u).add(v);
        graph.get(v).add(u); // remove for directed graph
    }

    /* ===================== 1. BFS ===================== */
    static void bfs(int start) {
        boolean[] visited = new boolean[graph.size()];
        Queue<Integer> q = new LinkedList<>();

        q.add(start);
        visited[start] = true;

        while (!q.isEmpty()) {
            int node = q.poll();
            System.out.print(node + " ");

            for (int nei : graph.get(node)) {
                if (!visited[nei]) {
                    visited[nei] = true;
                    q.add(nei);
                }
            }
        }
    }

    /* ===================== 2. DFS ===================== */
    static void dfs(int node, boolean[] visited) {
        visited[node] = true;
        System.out.print(node + " ");

        for (int nei : graph.get(node)) {
            if (!visited[nei])
                dfs(nei, visited);
        }
    }

    /* ===================== 3. CYCLE DETECTION (UNDIRECTED) ===================== */
    static boolean hasCycle(int node, int parent, boolean[] visited) {
        visited[node] = true;

        for (int nei : graph.get(node)) {
            if (!visited[nei]) {
                if (hasCycle(nei, node, visited))
                    return true;
            } else if (nei != parent) {
                return true;
            }
        }
        return false;
    }

    /* ===================== 4. CYCLE DETECTION (DIRECTED) ===================== */
    static boolean hasCycleDirected(int node, boolean[] visited, boolean[] rec) {
        visited[node] = true;
        rec[node] = true;

        for (int nei : graph.get(node)) {
            if (!visited[nei] && hasCycleDirected(nei, visited, rec))
                return true;
            else if (rec[nei])
                return true;
        }

        rec[node] = false;
        return false;
    }

    /* ===================== 5. TOPOLOGICAL SORT (DFS) ===================== */
    static void topoSortDFS(int node, boolean[] visited, Stack<Integer> st) {
        visited[node] = true;

        for (int nei : graph.get(node)) {
            if (!visited[nei])
                topoSortDFS(nei, visited, st);
        }

        st.push(node);
    }

    /* ===================== 6. TOPO SORT (KAHN BFS) ===================== */
    static void topoSortBFS(int n) {
        int[] indegree = new int[n];

        for (int i = 0; i < n; i++) {
            for (int nei : graph.get(i))
                indegree[nei]++;
        }

        Queue<Integer> q = new LinkedList<>();
        for (int i = 0; i < n; i++)
            if (indegree[i] == 0)
                q.add(i);

        while (!q.isEmpty()) {
            int node = q.poll();
            System.out.print(node + " ");

            for (int nei : graph.get(node)) {
                indegree[nei]--;
                if (indegree[nei] == 0)
                    q.add(nei);
            }
        }
    }

    /* ===================== 7. DIJKSTRA ===================== */
    static void dijkstra(int src, int n, List<List<int[]>> g) {
        int[] dist = new int[n];
        Arrays.fill(dist, Integer.MAX_VALUE);

        PriorityQueue<int[]> pq = new PriorityQueue<>((a, b) -> a[1] - b[1]);

        dist[src] = 0;
        pq.add(new int[]{src, 0});

        while (!pq.isEmpty()) {
            int[] curr = pq.poll();
            int node = curr[0];
            int d = curr[1];

            for (int[] nei : g.get(node)) {
                int next = nei[0];
                int wt = nei[1];

                if (d + wt < dist[next]) {
                    dist[next] = d + wt;
                    pq.add(new int[]{next, dist[next]});
                }
            }
        }

        System.out.println("Distances: " + Arrays.toString(dist));
    }

    /* ===================== 8. UNION-FIND ===================== */
    static int[] parent, rank;

    static void initUF(int n) {
        parent = new int[n];
        rank = new int[n];

        for (int i = 0; i < n; i++)
            parent[i] = i;
    }

    static int find(int x) {
        if (parent[x] != x)
            parent[x] = find(parent[x]);
        return parent[x];
    }

    static void union(int a, int b) {
        int pa = find(a), pb = find(b);

        if (pa != pb) {
            if (rank[pa] < rank[pb])
                parent[pa] = pb;
            else if (rank[pa] > rank[pb])
                parent[pb] = pa;
            else {
                parent[pb] = pa;
                rank[pa]++;
            }
        }
    }

    /* ===================== MAIN ===================== */
    public static void main(String[] args) {

        int n = 5;
        buildGraph(n);

        addEdge(0, 1);
        addEdge(0, 2);
        addEdge(1, 3);
        addEdge(2, 4);

        System.out.print("BFS: ");
        bfs(0);

        System.out.print("\nDFS: ");
        dfs(0, new boolean[n]);

        System.out.println("\nHas Cycle: " + hasCycle(0, -1, new boolean[n]));

        System.out.print("Topo Sort (BFS): ");
        topoSortBFS(n);

        // Union-Find
        initUF(n);
        union(1, 2);
        union(2, 3);
        System.out.println("\nFind(3): " + find(3));
    }
}
