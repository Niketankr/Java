public class BellmanFord {
    public static void main(String[] args){
        int V=5;
        int[][] edges={
            {0,1,5},{1,2,-2},{2,3,3}
        };

        int[] dist=new int[V];
        for(int i=0;i<V;i++) dist[i]=100000;
        dist[0]=0;

        for(int i=0;i<V-1;i++){
            for(int[] e:edges){
                int u=e[0],v=e[1],w=e[2];
                if(dist[u]+w<dist[v])
                    dist[v]=dist[u]+w;
            }
        }
    }
}

public class Floyd {
    public static void main(String[] args){
        int[][] dist={
            {0,5,999},
            {999,0,3},
            {999,999,0}
        };

        int n=3;

        for(int k=0;k<n;k++)
            for(int i=0;i<n;i++)
                for(int j=0;j<n;j++)
                    dist[i][j]=Math.min(dist[i][j],
                        dist[i][k]+dist[k][j]);
    }
}


import java.util.*;

class Pair {
    int node, dist;
    Pair(int n,int d){node=n;dist=d;}
}

public class Dijkstra {
    public static void main(String[] args){
        int V=3;

        ArrayList<ArrayList<Pair>> adj=new ArrayList<>();
        for(int i=0;i<V;i++) adj.add(new ArrayList<>());

        adj.get(0).add(new Pair(1,1));
        adj.get(1).add(new Pair(2,2));

        PriorityQueue<Pair> pq =
            new PriorityQueue<>((a,b)->a.dist-b.dist);

        int[] dist=new int[V];
        Arrays.fill(dist, Integer.MAX_VALUE);

        dist[0]=0;
        pq.add(new Pair(0,0));

        while(!pq.isEmpty()){
            Pair p=pq.poll();

            for(Pair it:adj.get(p.node)){
                if(p.dist+it.dist<dist[it.node]){
                    dist[it.node]=p.dist+it.dist;
                    pq.add(new Pair(it.node,dist[it.node]));
                }
            }
        }
    }
}
