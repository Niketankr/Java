import java.util.*;

public class Activity {
    public static void main(String[] args) {
        int start[] = {1,3,0,5,8,5};
        int end[]   = {2,4,6,7,9,9};

        int n = start.length;

        int[][] act = new int[n][2];
        for(int i=0;i<n;i++){
            act[i][0]=start[i];
            act[i][1]=end[i];
        }

        Arrays.sort(act, (a,b)->a[1]-b[1]);

        int count = 1;
        int lastEnd = act[0][1];

        for(int i=1;i<n;i++){
            if(act[i][0] >= lastEnd){
                count++;
                lastEnd = act[i][1];
            }
        }

        System.out.println(count);
    }
}

output:
4


import java.util.*;

public class Platform {
    public static void main(String[] args) {
        int arr[] = {900,940,950,1100,1500,1800};
        int dep[] = {910,1200,1120,1130,1900,2000};

        Arrays.sort(arr);
        Arrays.sort(dep);

        int i=0,j=0,plat=0,max=0;

        while(i<arr.length && j<dep.length){
            if(arr[i] <= dep[j]){
                plat++;
                i++;
            } else {
                plat--;
                j++;
            }
            max = Math.max(max, plat);
        }

        System.out.println(max);
    }
}
output:
3

