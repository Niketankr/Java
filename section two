import java.util.*;

public class Main {

    // 11. Reverse String
    static String reverseString(String str) {
        StringBuilder sb = new StringBuilder(str);
        return sb.reverse().toString();
    }

    // 12. Palindrome String
    static boolean isPalindrome(String str) {
        int i = 0, j = str.length() - 1;
        while (i < j) {
            if (str.charAt(i) != str.charAt(j))
                return false;
            i++;
            j--;
        }
        return true;
    }

    // 13. Count Vowels & Consonants
    static void countVC(String str) {
        int vowels = 0, consonants = 0;

        str = str.toLowerCase();

        for (char c : str.toCharArray()) {
            if (Character.isLetter(c)) {
                if ("aeiou".indexOf(c) != -1)
                    vowels++;
                else
                    consonants++;
            }
        }

        System.out.println("Vowels: " + vowels);
        System.out.println("Consonants: " + consonants);
    }

    // 14. Remove Duplicates
    static String removeDuplicates(String str) {
        Set<Character> set = new LinkedHashSet<>();
        for (char c : str.toCharArray()) {
            set.add(c);
        }

        StringBuilder result = new StringBuilder();
        for (char c : set) {
            result.append(c);
        }

        return result.toString();
    }

    // 15. Character Frequency
    static void frequency(String str) {
        int[] freq = new int[256];

        for (char c : str.toCharArray()) {
            freq[c]++;
        }

        for (int i = 0; i < 256; i++) {
            if (freq[i] > 0) {
                System.out.println((char) i + " : " + freq[i]);
            }
        }
    }

    // 16. Anagram Check
    static boolean isAnagram(String s1, String s2) {
        if (s1.length() != s2.length()) return false;

        char[] a = s1.toCharArray();
        char[] b = s2.toCharArray();

        Arrays.sort(a);
        Arrays.sort(b);

        return Arrays.equals(a, b);
    }

    // 17. First Non-Repeating Character
    static char firstNonRepeat(String str) {
        int[] freq = new int[256];

        for (char c : str.toCharArray()) {
            freq[c]++;
        }

        for (char c : str.toCharArray()) {
            if (freq[c] == 1)
                return c;
        }

        return '#'; // no unique char
    }

    // 18. Lowercase to Uppercase
    static String toUpper(String str) {
        return str.toUpperCase();
    }

    // MAIN METHOD
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter a string: ");
        String str = sc.nextLine();

        System.out.println("Reverse: " + reverseString(str));

        System.out.println("Palindrome: " + isPalindrome(str));

        countVC(str);

        System.out.println("Without Duplicates: " + removeDuplicates(str));

        System.out.println("Character Frequency:");
        frequency(str);

        System.out.print("Enter second string for anagram: ");
        String str2 = sc.nextLine();
        System.out.println("Anagram: " + isAnagram(str, str2));

        System.out.println("First Non-Repeating: " + firstNonRepeat(str));

        System.out.println("Uppercase: " + toUpper(str));

        sc.close();
    }
}
