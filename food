import java.util.*;

public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int totalBill = 0;

        while (true) {

            System.out.println("\n===== FOOD DELIVERY APP =====");

            System.out.println("1. Burger   ₹120");
            System.out.println("2. Pizza    ₹300");
            System.out.println("3. Biryani  ₹250");
            System.out.println("4. Sandwich ₹150");
            System.out.println("5. Checkout");

            System.out.print("Select item: ");

            int choice = sc.nextInt();

            if (choice == 5) {

                System.out.println(
                        "\nTotal Bill = ₹"
                                + totalBill
                );

                System.out.println(
                        "Order Placed Successfully"
                );

                break;
            }

            System.out.print(
                    "Enter Quantity: "
            );

            int qty = sc.nextInt();

            switch (choice) {

                case 1:
                    totalBill += 120 * qty;
                    break;

                case 2:
                    totalBill += 300 * qty;
                    break;

                case 3:
                    totalBill += 250 * qty;
                    break;

                case 4:
                    totalBill += 150 * qty;
                    break;

                default:
                    System.out.println(
                            "Invalid Item"
                    );
            }

            System.out.println(
                    "Current Bill = ₹"
                            + totalBill
            );
        }

        sc.close();
    }
}
